# Copy to deploy/.env on BOTH VMs: cp deploy/.env.example deploy/.env
# Every run-*.sh script reads it. Values can also be overridden per run, e.g. Q=2 ./deploy/run-consumer.sh

# ---- Consumer VM ----
CONSUMER_HOST=192.168.56.20     # consumer VM's IP (the producer VM connects here)
CONSUMER_PORT=50051             # gRPC upload port
GUI_PORT=8080                   # web GUI: http://CONSUMER_HOST:GUI_PORT
DATA_DIR=data                   # where uploads, previews, thumbnails and catalog.json go
C=2                             # consumer worker threads
Q=10                            # max queue length (leaky bucket: extra uploads are dropped)

# ---- Producer VM ----
P=3                                            # producer threads
FOLDERS="videos/p1 videos/p2 videos/p3"        # one folder per thread, P of them
